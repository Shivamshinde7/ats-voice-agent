PORT=3100
LOCAL_TEST_PORT=3200
VOICE_PROVIDER=browser
ENABLE_EXOTEL_AGENTSTREAM=false
AI_VOICE_AGENT_TOKEN=replace-with-a-long-random-token
AI_VOICE_AGENT_SHARED_SECRET=replace-with-a-different-long-random-secret
LARAVEL_WEBHOOK_URL=https://ats.example.com/api/ai-calling/webhook
AI_CALLING_LOCAL_TEST_API_URL=http://127.0.0.1:8000/api/ai-calling/local-test/calls

EXOTEL_BASE_URL=https://api.in.exotel.com
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_FLOW_ID=
EXOTEL_REGION=

SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=ishita_enhi_customer
SARVAM_TTS_PACE=1.0
# 16000 for browser, 8000 only for Exotel
SARVAM_SAMPLE_RATE=16000
BARGE_IN_ENABLED=false
ACK_ENABLED=false
SARVAM_STT_VAD_THRESHOLD=0.3
SARVAM_STT_SILENCE_DURATION_MS=700
SARVAM_STT_MIN_SPEECH_DURATION_MS=250
SARVAM_LLM_MODEL=sarvam-105b-conversations
LLM_TIMEOUT_MS=25000
LLM_RETRIES=1

# Voice-session liveness and safety limits.
SILENCE_PROMPT_SECONDS=8
MAX_CALL_DURATION_SECONDS=360
WEBSOCKET_PING_INTERVAL_MS=30000
WEBSOCKET_IDLE_TIMEOUT_MS=120000
STT_KEEP_ALIVE_INTERVAL_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=120000

# STT/VAD and post-playback turn timing.
BARGE_IN_SENSITIVITY=0.3
BARGE_IN_MIN_SPEECH_MS=250
BARGE_IN_SILENCE_TIMEOUT_MS=700
POST_TTS_DELAY_MS=0
END_OF_SPEECH_MS=400

# Browser capture uses WebRTC echo cancellation, noise suppression, and auto gain control.
# Node applies a light high-pass filter; enable its optional energy VAD only after tuning.
AUDIO_PROCESSING_ENABLED=true
AUDIO_NOISE_SUPPRESSION_ENABLED=true
AUDIO_VAD_ENABLED=false
AUDIO_ECHO_CANCELLATION_ENABLED=true
AUDIO_VAD_THRESHOLD_DB=-42

# Configure an OpenAI-compatible chat-completions API.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
